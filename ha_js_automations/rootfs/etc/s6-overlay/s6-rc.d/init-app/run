#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Studio Code Server
# Sets up TS types
# ==============================================================================



entities=$(curl -sb -X GET -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" -H "Content-Type: application/json" http://supervisor/core/api/states \
 | jq -M --tab '[ .[].entity_id ]')
echo "export default ${entities} as const;" > /automations/ha-js-automations/src/const/entities.ts


actions=$(curl -sb -X GET -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" -H "Content-Type: application/json" http://supervisor/core/api/services \
 | jq -M --tab '[ .[] | {(.domain): (.services | keys)} ] | add')
echo "export default ${actions} as const;" > /automations/ha-js-automations/src/const/actions.ts
cat /automations/ha-js-automations/src/const/actions.ts

cd /automations/ || bashio::debug "Could not change working directory"
pnpm build

# Install user configured/requested packages
if bashio::config.has_value 'npm_packages'; then
    cd /automations/main || bashio::exit.nok "Could not change directory to Node-RED"

    bashio::log.info "Starting installation of custom NPM packages..."
    for package in $(bashio::config 'npm_packages'); do
        npmlist+=("$package")
    done

    pnpm install \
        "${npmlist[@]}" \
           || bashio::exit.nok "Failed to install a specified pnpm package"
fi

echo "ls -Al /automations/ha-js-automations/dist/"
ls -Al /automations/ha-js-automations/dist/
